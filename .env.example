# ---- Application ----
LOG_LEVEL=INFO
OTEL_SERVICE_NAME=scai-mcp-admissions

# ---- Database ----
# Match docker-compose.yml defaults
DATABASE_URL=postgresql+psycopg://scai:scai@localhost:5432/scai_admissions

# ---- MCP ----
MCP_SERVER_URL=http://localhost:8010/
MCP_PROTOCOL_VERSION=2026-07-28

# ---- Auth (dev only; generate a real key with scripts/issue_dev_token.py --new-key) ----
JWT_SIGNING_KEY=dev-only-do-not-use-in-production-replace-me
JWT_AUDIENCE=scai-admissions
JWT_ISSUER=scai-dev

# ---- Model adapter ----
# ollama | openai-compatible
MODEL_PROVIDER=ollama
MODEL_NAME=gemma4:latest
MODEL_BASE_URL=http://localhost:11434/v1
MODEL_API_KEY=ollama

# ---- Service ports ----
MCP_PORT=8010
LEARNER_HOST_PORT=8020
COUNSELLOR_HOST_PORT=8030